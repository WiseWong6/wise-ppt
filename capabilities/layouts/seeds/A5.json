    "scoped_css": "@scope (.slide[data-layout-id=\"wise-ppt.layout.relationship.A5\"]) {\nsvg.scene { position: absolute; inset: 0; z-index: 1; }\n  .caption {\n    position: absolute; left: 0; right: 0; bottom: 118px;\n    text-align: center;\n    font-family: var(--sans); font-weight: 400;\n    font-size: var(--type-caption); letter-spacing: .04em;\n    color: var(--ink);\n    z-index: 5;\n  }\n}\n",
    "css_sha256": "1098e932de4ade6d217d1d5f5ee0081d15292e9ab04e65fae16508eb22cfe349",
    "stage_html": "<div class=\"stage\" data-block-id=\"gallery-primary\" data-component-id=\"native.wise-ppt.evidence.policy-columns.clauses\" data-component-source=\"native\" data-content-ref=\"example.a5\" data-renderer-kind=\"svg\">\n<div class=\"doc tl\"><span class=\"vnext-text-node\" data-vnext-fit-box=\"0,0,1920,1080\" data-vnext-text-key=\"support.text.001\">PPT 标题</span><br/><span class=\"vnext-text-node\" data-vnext-fit-box=\"0,0,1920,1080\" data-vnext-text-key=\"support.text.002\">页面标题</span></div>\n<div class=\"folio\">页码 / 总页数 — BY @歪斯Wise</div>\n<svg class=\"scene\" height=\"1080\" viewbox=\"0 0 1920 1080\" width=\"1920\">\n<g id=\"draw\"><g transform=\"translate(0 -40.2)\"><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.001\" fill=\"var(--ink-45)\" font-family=\"var(--mono)\" font-size=\"var(--type-meta)\" letter-spacing=\"3\" x=\"209\" y=\"246\">CH.1 · SCHEDULE</text><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.002\" data-vnext-type-slot=\"content-title\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-subheading)\" font-weight=\"300\" id=\"a5-column-209\" x=\"209\" y=\"296\">进度与里程碑</text><line data-vnext-visual-role=\"a5.column-title-rule\" opacity=\"1\" stroke=\"var(--ink)\" stroke-width=\"2\" x1=\"209\" x2=\"359\" y1=\"316\" y2=\"316\"></line><line data-vnext-visual-role=\"a5.column-title-subrule\" opacity=\"1\" stroke=\"var(--ink)\" stroke-width=\"1\" x1=\"209\" x2=\"273\" y1=\"321\" y2=\"321\"></line><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.003\" fill=\"var(--ink-45)\" font-family=\"var(--mono)\" font-size=\"var(--type-meta)\" letter-spacing=\"3\" x=\"781\" y=\"246\">CH.2 · SERVICE PROVISION</text><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.004\" data-vnext-type-slot=\"content-title\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-subheading)\" font-weight=\"300\" id=\"a5-column-781\" x=\"781\" y=\"296\">服务提供</text><line data-vnext-visual-role=\"a5.column-title-rule\" opacity=\"1\" stroke=\"var(--ink)\" stroke-width=\"2\" x1=\"781\" x2=\"931\" y1=\"316\" y2=\"316\"></line><line data-vnext-visual-role=\"a5.column-title-subrule\" opacity=\"1\" stroke=\"var(--ink)\" stroke-width=\"1\" x1=\"781\" x2=\"845\" y1=\"321\" y2=\"321\"></line><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.005\" fill=\"var(--ink-45)\" font-family=\"var(--mono)\" font-size=\"var(--type-meta)\" letter-spacing=\"3\" x=\"1353\" y=\"246\">CH.3 · CONTENT &amp; REVIEW</text><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.006\" data-vnext-type-slot=\"content-title\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-subheading)\" font-weight=\"300\" id=\"sample-focus\" x=\"1353\" y=\"296\">内容与质检</text><line data-vnext-visual-role=\"a5.column-title-rule\" opacity=\"1\" stroke=\"var(--ink)\" stroke-width=\"2\" x1=\"1353\" x2=\"1503\" y1=\"316\" y2=\"316\"></line><line data-vnext-visual-role=\"a5.column-title-subrule\" opacity=\"1\" stroke=\"var(--ink)\" stroke-width=\"1\" x1=\"1353\" x2=\"1417\" y1=\"321\" y2=\"321\"></line><line opacity=\"0.22\" stroke=\"var(--ink)\" stroke-width=\"0.8\" x1=\"701\" x2=\"701\" y1=\"338\" y2=\"820\"></line><line opacity=\"0.22\" stroke=\"var(--ink)\" stroke-width=\"0.8\" x1=\"1237\" x2=\"1237\" y1=\"338\" y2=\"820\"></line><g data-number-kind=\"circled\" data-number-rings=\"1\" data-number-role=\"structural\" data-number-state=\"outline\"><circle cx=\"218\" cy=\"366\" data-number-part=\"disc\" fill=\"none\" r=\"11\" stroke=\"var(--ink)\" stroke-width=\"1\"></circle><text data-number-part=\"label\" data-text-kind=\"number\" data-vnext-fit-box=\"204,311,232,340\" data-vnext-text-key=\"clauses.text.007\" fill=\"var(--ink)\" font-family=\"var(--mono)\" font-size=\"var(--type-meta)\" text-anchor=\"middle\" x=\"218\" y=\"371\">1</text></g><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.008\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"243\" y=\"372\">项目启动阶段应输出经过评审确认的</text><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.009\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"243\" y=\"412\">里程碑计划与责任分工，明确到具体执行人。</text><g data-number-kind=\"circled\" data-number-rings=\"1\" data-number-role=\"structural\" data-number-state=\"outline\"><circle cx=\"218\" cy=\"476\" data-number-part=\"disc\" fill=\"none\" r=\"11\" stroke=\"var(--ink)\" stroke-width=\"1\"></circle><text data-number-part=\"label\" data-text-kind=\"number\" data-vnext-fit-box=\"204,421,232,450\" data-vnext-text-key=\"clauses.text.010\" fill=\"var(--ink)\" font-family=\"var(--mono)\" font-size=\"var(--type-meta)\" text-anchor=\"middle\" x=\"218\" y=\"481\">2</text></g><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.011\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"243\" y=\"482\">阶段成果进入评审队列后，评审意见</text><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.012\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"243\" y=\"522\">须在两个工作日内闭环并留存记录。</text><g data-number-kind=\"circled\" data-number-rings=\"1\" data-number-role=\"structural\" data-number-state=\"outline\"><circle cx=\"218\" cy=\"586\" data-number-part=\"disc\" fill=\"none\" r=\"11\" stroke=\"var(--ink)\" stroke-width=\"1\"></circle><text data-number-part=\"label\" data-text-kind=\"number\" data-vnext-fit-box=\"204,531,232,560\" data-vnext-text-key=\"clauses.text.013\" fill=\"var(--ink)\" font-family=\"var(--mono)\" font-size=\"var(--type-meta)\" text-anchor=\"middle\" x=\"218\" y=\"591\">3</text></g><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.014\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"243\" y=\"592\">进度偏差超过计划百分之十的，应当</text><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.015\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"243\" y=\"632\">书面说明原因并提出追赶方案。</text><g data-number-kind=\"circled\" data-number-rings=\"1\" data-number-role=\"structural\" data-number-state=\"outline\"><circle cx=\"218\" cy=\"696\" data-number-part=\"disc\" fill=\"none\" r=\"11\" stroke=\"var(--ink)\" stroke-width=\"1\"></circle><text data-number-part=\"label\" data-text-kind=\"number\" data-vnext-fit-box=\"204,641,232,670\" data-vnext-text-key=\"clauses.text.016\" fill=\"var(--ink)\" font-family=\"var(--mono)\" font-size=\"var(--type-meta)\" text-anchor=\"middle\" x=\"218\" y=\"701\">4</text></g><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.017\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"243\" y=\"702\">交付团队应当持续改进交付质量，</text><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.018\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"243\" y=\"742\">提升成果的完整性、一致性与可复用性。</text><g data-number-kind=\"circled\" data-number-rings=\"1\" data-number-role=\"structural\" data-number-state=\"outline\"><circle cx=\"218\" cy=\"806\" data-number-part=\"disc\" fill=\"none\" r=\"11\" stroke=\"var(--ink)\" stroke-width=\"1\"></circle><text data-number-part=\"label\" data-text-kind=\"number\" data-vnext-fit-box=\"204,751,232,780\" data-vnext-text-key=\"clauses.text.019\" fill=\"var(--ink)\" font-family=\"var(--mono)\" font-size=\"var(--type-meta)\" text-anchor=\"middle\" x=\"218\" y=\"811\">5</text></g><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.020\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"243\" y=\"812\">交付范围发生重大变更的，应重新进行</text><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.021\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"243\" y=\"852\">范围确认与计划评审程序。</text><g data-number-kind=\"circled\" data-number-rings=\"1\" data-number-role=\"structural\" data-number-state=\"outline\"><circle cx=\"790\" cy=\"366\" data-number-part=\"disc\" fill=\"none\" r=\"11\" stroke=\"var(--ink)\" stroke-width=\"1\"></circle><text data-number-part=\"label\" data-text-kind=\"number\" data-vnext-fit-box=\"776,311,804,340\" data-vnext-text-key=\"clauses.text.022\" fill=\"var(--ink)\" font-family=\"var(--mono)\" font-size=\"var(--type-meta)\" text-anchor=\"middle\" x=\"790\" y=\"371\">1</text></g><text fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"815\" y=\"372\"><tspan data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.023\">服务启动前应完成</tspan><tspan data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.024\" id=\"a5-regulation-1\">《xx 服务响应</tspan></text><text fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"815\" y=\"412\"><tspan data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.025\" id=\"a5-regulation-2\">与升级管理办法》</tspan><tspan data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.026\">制度的宣贯培训。</tspan></text><g data-number-kind=\"circled\" data-number-rings=\"1\" data-number-role=\"structural\" data-number-state=\"outline\"><circle cx=\"790\" cy=\"476\" data-number-part=\"disc\" fill=\"none\" r=\"11\" stroke=\"var(--ink)\" stroke-width=\"1\"></circle><text data-number-part=\"label\" data-text-kind=\"number\" data-vnext-fit-box=\"776,421,804,450\" data-vnext-text-key=\"clauses.text.027\" fill=\"var(--ink)\" font-family=\"var(--mono)\" font-size=\"var(--type-meta)\" text-anchor=\"middle\" x=\"790\" y=\"481\">2</text></g><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.028\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"815\" y=\"482\">应与注册使用者签订服务协议，明确</text><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.029\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"815\" y=\"522\">双方权利义务与禁止内容。</text><g data-number-kind=\"circled\" data-number-rings=\"1\" data-number-role=\"structural\" data-number-state=\"outline\"><circle cx=\"790\" cy=\"586\" data-number-part=\"disc\" fill=\"none\" r=\"11\" stroke=\"var(--ink)\" stroke-width=\"1\"></circle><text data-number-part=\"label\" data-text-kind=\"number\" data-vnext-fit-box=\"776,531,804,560\" data-vnext-text-key=\"clauses.text.030\" fill=\"var(--ink)\" font-family=\"var(--mono)\" font-size=\"var(--type-meta)\" text-anchor=\"middle\" x=\"790\" y=\"591\">3</text></g><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.031\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"815\" y=\"592\">紧急问题应按最高优先级响应，</text><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.032\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"815\" y=\"632\">并在处置后向全体相关方同步。</text><g data-number-kind=\"circled\" data-number-rings=\"1\" data-number-role=\"structural\" data-number-state=\"outline\"><circle cx=\"790\" cy=\"696\" data-number-part=\"disc\" fill=\"none\" r=\"11\" stroke=\"var(--ink)\" stroke-width=\"1\"></circle><text data-number-part=\"label\" data-text-kind=\"number\" data-vnext-fit-box=\"776,641,804,670\" data-vnext-text-key=\"clauses.text.033\" fill=\"var(--ink)\" font-family=\"var(--mono)\" font-size=\"var(--type-meta)\" text-anchor=\"middle\" x=\"790\" y=\"701\">4</text></g><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.034\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"815\" y=\"702\">每季度输出服务运行报告，内容</text><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.035\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"815\" y=\"742\">覆盖使用情况与改进计划。</text><g data-number-kind=\"circled\" data-number-rings=\"1\" data-number-role=\"structural\" data-number-state=\"outline\"><circle cx=\"790\" cy=\"806\" data-number-part=\"disc\" fill=\"none\" r=\"11\" stroke=\"var(--ink)\" stroke-width=\"1\"></circle><text data-number-part=\"label\" data-text-kind=\"number\" data-vnext-fit-box=\"776,751,804,780\" data-vnext-text-key=\"clauses.text.036\" fill=\"var(--ink)\" font-family=\"var(--mono)\" font-size=\"var(--type-meta)\" text-anchor=\"middle\" x=\"790\" y=\"811\">5</text></g><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.037\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"815\" y=\"812\">应建立公众投诉举报受理机制，及时</text><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.038\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"815\" y=\"852\">处置并反馈处理情况。</text><g data-number-kind=\"circled\" data-number-rings=\"1\" data-number-role=\"structural\" data-number-state=\"outline\"><circle cx=\"1362\" cy=\"366\" data-number-part=\"disc\" fill=\"none\" r=\"11\" stroke=\"var(--ink)\" stroke-width=\"1\"></circle><text data-number-part=\"label\" data-text-kind=\"number\" data-vnext-fit-box=\"1348,311,1376,340\" data-vnext-text-key=\"clauses.text.039\" fill=\"var(--ink)\" font-family=\"var(--mono)\" font-size=\"var(--type-meta)\" text-anchor=\"middle\" x=\"1362\" y=\"371\">1</text></g><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.040\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"1387\" y=\"372\">内容产出应遵循统一风格规范，</text><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.041\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"1387\" y=\"412\">不得偏离确认过的选题与口径。</text><g data-number-kind=\"circled\" data-number-rings=\"1\" data-number-role=\"structural\" data-number-state=\"outline\"><circle cx=\"1362\" cy=\"476\" data-number-part=\"disc\" fill=\"none\" r=\"11\" stroke=\"var(--ink)\" stroke-width=\"1\"></circle><text data-number-part=\"label\" data-text-kind=\"number\" data-vnext-fit-box=\"1348,421,1376,450\" data-vnext-text-key=\"clauses.text.042\" fill=\"var(--ink)\" font-family=\"var(--mono)\" font-size=\"var(--type-meta)\" text-anchor=\"middle\" x=\"1362\" y=\"481\">2</text></g><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.043\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"1387\" y=\"482\">引用外部数据时应核对来源，</text><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.044\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"1387\" y=\"522\">并标注采集时间与口径。</text><g data-number-kind=\"circled\" data-number-rings=\"1\" data-number-role=\"structural\" data-number-state=\"outline\"><circle cx=\"1362\" cy=\"586\" data-number-part=\"disc\" fill=\"none\" r=\"11\" stroke=\"var(--ink)\" stroke-width=\"1\"></circle><text data-number-part=\"label\" data-text-kind=\"number\" data-vnext-fit-box=\"1348,531,1376,560\" data-vnext-text-key=\"clauses.text.045\" fill=\"var(--ink)\" font-family=\"var(--mono)\" font-size=\"var(--type-meta)\" text-anchor=\"middle\" x=\"1362\" y=\"591\">3</text></g><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.046\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"1387\" y=\"592\">使用图片、视频等素材的，应</text><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.047\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"1387\" y=\"632\">确认授权状态并保留凭证备查。</text><g data-number-kind=\"circled\" data-number-rings=\"1\" data-number-role=\"structural\" data-number-state=\"outline\"><circle cx=\"1362\" cy=\"696\" data-number-part=\"disc\" fill=\"none\" r=\"11\" stroke=\"var(--ink)\" stroke-width=\"1\"></circle><text data-number-part=\"label\" data-text-kind=\"number\" data-vnext-fit-box=\"1348,641,1376,670\" data-vnext-text-key=\"clauses.text.048\" fill=\"var(--ink)\" font-family=\"var(--mono)\" font-size=\"var(--type-meta)\" text-anchor=\"middle\" x=\"1362\" y=\"701\">4</text></g><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.049\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"1387\" y=\"702\">质检抽检应覆盖全部交付页面，</text><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.050\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"1387\" y=\"742\">发现问题当日退回并限期修正。</text><g data-number-kind=\"circled\" data-number-rings=\"1\" data-number-role=\"structural\" data-number-state=\"outline\"><circle cx=\"1362\" cy=\"806\" data-number-part=\"disc\" fill=\"none\" r=\"11\" stroke=\"var(--ink)\" stroke-width=\"1\"></circle><text data-number-part=\"label\" data-text-kind=\"number\" data-vnext-fit-box=\"1348,751,1376,780\" data-vnext-text-key=\"clauses.text.051\" fill=\"var(--ink)\" font-family=\"var(--mono)\" font-size=\"var(--type-meta)\" text-anchor=\"middle\" x=\"1362\" y=\"811\">5</text></g><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.052\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"1387\" y=\"812\">未通过质检的产出不计入交付，</text><text data-vnext-fit-box=\"197,185,1649,828\" data-vnext-text-key=\"clauses.text.053\" fill=\"var(--ink)\" font-family=\"var(--sans)\" font-size=\"var(--type-body-small)\" font-weight=\"300\" x=\"1387\" y=\"852\">须整改后重新提交复检。</text></g></g>\n</svg>\n<div class=\"caption\" data-vnext-claim-key=\"claim.text.001\" data-vnext-fit-box=\"0,0,1920,1080\">进度、服务与内容质量都必须有明确责任链，项目交付不是只过一次验收测试。</div>\n</div>",
