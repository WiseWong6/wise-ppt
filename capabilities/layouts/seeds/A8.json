}\n  .run-id { display: inline-flex; align-items: center; gap: 12px; }\n  .dot { width: 9px; height: 9px; border-radius: 50%; flex: 0 0 auto;\n    border: 1px solid var(--ink); }\n  .dot.err { background: var(--ink); }\n  .dot.part { background: linear-gradient(90deg, var(--ink) 50%, transparent 50%); }\n  .ops { display: flex; flex-direction: column; gap: var(--space-1); align-items: flex-end; }\n  .ops span {\n    border: 1px solid var(--ink-45); padding: var(--space-1) var(--space-2);\n    font-size: var(--type-micro-secondary); font-family: var(--sans); font-weight: 300; white-space: nowrap;\n  }\n\n  /* 右：树形过程日志 */\n  .detail { flex: 1; border-left: 1px solid color-mix(in srgb, var(--ink) 35%, transparent); padding: var(--space-4) var(--space-6); }\n  .dhead { font-family: var(--mono); font-size: var(--type-meta); letter-spacing: .2em; color: var(--ink);\n    border-bottom: 1px solid color-mix(in srgb, var(--ink) 40%, transparent); padding-bottom: var(--space-3); margin-bottom: var(--space-2);\n    display: flex; justify-content: space-between; }\n  .dhead .id { color: var(--ink-45); letter-spacing: .05em; }\n\n  .tree { font-family: var(--sans); font-weight: 300; font-size: var(--type-label); color: var(--ink-70); }\n  .tnode { display: flex; align-items: baseline; gap: var(--space-3); padding: var(--space-2) 0; position: relative; }\n  .tnode .mono { font-family: var(--mono); font-size: var(--type-micro-secondary); color: var(--ink-45); margin-left: auto; }\n  .tnode .tag { font-family: var(--mono); font-size: var(--type-micro-secondary); color: var(--ink-45); }\n  .tnode .st-ok { color: var(--ink-45); }\n  .tnode .st-err { color: var(--ink); font-weight: 400; }\n  .tnode.sel { outline: 1px solid var(--ink); outline-offset: -1px; }\n  .tnode.off { opacity: .35; }\n\n  .io {\n    margin: var(--space-2) 0 var(--space-1) var(--space-8); padding: var(--space-3) var(--space-4);\n    border: 1px dashed var(--ink-55);\n    font-family: var(--mono); font-size: var(--