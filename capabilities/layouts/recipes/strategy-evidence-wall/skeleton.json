{
  "format": "wise-ppt-recipe-skeleton@1",
  "recipe_id": "paper-ink.evidence.strategy-evidence-wall",
  "canvas": {
    "width": 1920,
    "height": 1080
  },
  "content_region": {"anchor_id": "a4-main", "zone": "core-content"},
  "fragment": "capabilities/layouts/recipes/strategy-evidence-wall/fragment.html",
  "payload_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["doc", "kicker", "heading", "strategies", "proof_label", "evidence", "takeaway"],
    "properties": {
      "doc": {
        "type": "object",
        "additionalProperties": false,
        "required": ["line_1", "line_2"],
        "properties": {
          "line_1": {"type": "string", "minLength": 1, "maxLength": 36, "pattern": "[^\\r\\n]+"},
          "line_2": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "[^\\r\\n]+"}
        }
      },
      "kicker": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "[^\\r\\n]+"},
      "heading": {"type": "string", "minLength": 1, "maxLength": 18, "pattern": "[^\\r\\n]+"},
      "strategies": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "title", "action", "evidence"],
          "properties": {
            "number": {"type": "string", "pattern": "[0-9]{2}"},
            "title": {"type": "string", "minLength": 1, "maxLength": 14, "pattern": "[^\\r\\n]+"},
            "action": {"type": "string", "minLength": 1, "maxLength": 24, "pattern": "[^\\r\\n]+"},
            "evidence": {"type": "string", "minLength": 1, "maxLength": 24, "pattern": "[^\\r\\n]+"}
          }
        }
      },
      "proof_label": {"type": "string", "minLength": 1, "maxLength": 8, "pattern": "[A-Z0-9 .·_-]+"},
      "evidence": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "label"],
          "properties": {
            "tag": {"type": "string", "minLength": 1, "maxLength": 28, "pattern": "[^\\r\\n]+"},
            "label": {"type": "string", "minLength": 1, "maxLength": 30, "pattern": "[^\\r\\n]+"}
          }
        }
      },
      "takeaway": {"type": "string", "minLength": 1, "maxLength": 48, "pattern": "[^\\r\\n]+"}
    }
  },
  "default_payload": {
    "doc": {
      "line_1": "品牌 · 策划 — A4",
      "line_2": "年度传播策略证据墙"
    },
    "kicker": "BRAND · YEAR PLAN",
    "heading": "年度策略，依据清楚",
    "strategies": [
      {"number": "01", "title": "品牌主张", "action": "从用户印象中提炼一句清楚主张", "evidence": "依据：用户访谈与关键词归纳"},
      {"number": "02", "title": "内容主题", "action": "把年度重点拆成季度内容主题", "evidence": "依据：内容表现与评论反馈"},
      {"number": "03", "title": "节点计划", "action": "围绕新品、节日与线下活动排期", "evidence": "依据：业务节奏与公众日历"},
      {"number": "04", "title": "渠道协同", "action": "统一官网、社媒与线下物料表达", "evidence": "依据：渠道清单与发布检查"}
    ],
    "proof_label": "PROOF",
    "evidence": [
      {"tag": "EXHIBIT 01 — USER VOICE", "label": "INTERVIEWS · KEYWORDS"},
      {"tag": "EXHIBIT 02 — CONTENT REVIEW", "label": "TOPICS · RESPONSE"},
      {"tag": "EXHIBIT 03 — VISUAL DRAFT", "label": "DIRECTION · CONSISTENCY"},
      {"tag": "EXHIBIT 04 — CALENDAR", "label": "OWNED · SOCIAL · OFFLINE"}
    ],
    "takeaway": "用访谈、内容回看、视觉提案与渠道排期，让年度品牌策划从判断走向行动。"
  },
  "anchors": [
    {"anchor_id": "stage", "selector": "[data-anchor-id=\"stage\"]"},
    {"anchor_id": "a4-main", "selector": "[data-anchor-id=\"a4-main\"]"},
    {"anchor_id": "a4-left", "selector": "[data-anchor-id=\"a4-left\"]"},
    {"anchor_id": "a4-arrow", "selector": "[data-anchor-id=\"a4-arrow\"]"},
    {"anchor_id": "a4-right", "selector": "[data-anchor-id=\"a4-right\"]"},
    {"anchor_id": "a4-card-1", "selector": "[data-anchor-id=\"a4-card-1\"]"},
    {"anchor_id": "a4-card-2", "selector": "[data-anchor-id=\"a4-card-2\"]"},
    {"anchor_id": "a4-card-3", "selector": "[data-anchor-id=\"a4-card-3\"]"},
    {"anchor_id": "a4-card-4", "selector": "[data-anchor-id=\"a4-card-4\"]"},
    {"anchor_id": "a4-support", "selector": "[data-anchor-id=\"a4-support\"]"},
    {"anchor_id": "a4-takeaway", "selector": "[data-anchor-id=\"a4-takeaway\"]"}
  ],
  "relations": [
    {"relation_id": "a4-main-in-stage", "type": "contain", "anchors": ["stage", "a4-main"], "tolerance": 0.25},
    {"relation_id": "a4-left-in-main", "type": "contain", "anchors": ["a4-main", "a4-left"], "tolerance": 0.25},
    {"relation_id": "a4-arrow-in-main", "type": "contain", "anchors": ["a4-main", "a4-arrow"], "tolerance": 0.25},
    {"relation_id": "a4-right-in-main", "type": "contain", "anchors": ["a4-main", "a4-right"], "tolerance": 0.25},
    {"relation_id": "a4-card-1-in-wall", "type": "contain", "anchors": ["a4-right", "a4-card-1"], "tolerance": 0.25},
    {"relation_id": "a4-card-2-in-wall", "type": "contain", "anchors": ["a4-right", "a4-card-2"], "tolerance": 0.25},
    {"relation_id": "a4-card-3-in-wall", "type": "contain", "anchors": ["a4-right", "a4-card-3"], "tolerance": 0.25},
    {"relation_id": "a4-card-4-in-wall", "type": "contain", "anchors": ["a4-right", "a4-card-4"], "tolerance": 0.25},
    {"relation_id": "a4-left-arrow-clear", "type": "avoid", "anchors": ["a4-left", "a4-arrow"], "min_gap": 28, "tolerance": 1},
    {"relation_id": "a4-arrow-right-clear", "type": "avoid", "anchors": ["a4-arrow", "a4-right"], "min_gap": 24, "tolerance": 1},
    {"relation_id": "a4-top-row-clear", "type": "avoid", "anchors": ["a4-card-1", "a4-card-2"], "min_gap": 40, "tolerance": 1},
    {"relation_id": "a4-bottom-row-clear", "type": "avoid", "anchors": ["a4-card-3", "a4-card-4"], "min_gap": 40, "tolerance": 1},
    {"relation_id": "a4-left-column-clear", "type": "avoid", "anchors": ["a4-card-1", "a4-card-3"], "min_gap": 50, "tolerance": 1},
    {"relation_id": "a4-right-column-clear", "type": "avoid", "anchors": ["a4-card-2", "a4-card-4"], "min_gap": 50, "tolerance": 1},
    {"relation_id": "a4-wall-top-align", "type": "edgeEq", "anchors": ["a4-left", "a4-right"], "edge": "top", "tolerance": 1},
    {"relation_id": "a4-wall-bottom-align", "type": "edgeEq", "anchors": ["a4-left", "a4-right"], "edge": "bottom", "tolerance": 1},
    {"relation_id": "a4-card-left-column", "type": "edgeEq", "anchors": ["a4-card-1", "a4-card-3"], "edge": "left", "tolerance": 1},
    {"relation_id": "a4-card-right-column", "type": "edgeEq", "anchors": ["a4-card-2", "a4-card-4"], "edge": "left", "tolerance": 1},
    {"relation_id": "a4-card-top-row", "type": "edgeEq", "anchors": ["a4-card-1", "a4-card-2"], "edge": "top", "tolerance": 1},
    {"relation_id": "a4-card-bottom-row", "type": "edgeEq", "anchors": ["a4-card-3", "a4-card-4"], "edge": "top", "tolerance": 1},
    {"relation_id": "a4-arrow-centered", "type": "centerBetween", "anchors": ["a4-arrow", "a4-left", "a4-right"], "tolerance": 6}
  ],
  "allowed_variants": {},
  "requires": [],
  "invariants": []
}
