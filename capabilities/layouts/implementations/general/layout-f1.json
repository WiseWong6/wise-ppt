      "html.text.002": "渠道价值 × 内容势能",
      "html.text.003": "01 / 01 — BY WISE PPT",
      "html.text.004": "渠道价值决定触达效率，内容势能决定传播深度；两者都高，才值得长期经营。",
      "script.literal.001": "高势能",
      "script.literal.002": "CONTENT ↑",
      "script.literal.003": "高价值 →",
      "script.literal.004": "CHANNEL",
      "script.literal.005": "0",
      "script.literal.006": "声量放大",
      "script.literal.007": "内容有话题与记忆点，",
      "script.literal.008": "但渠道承接仍然偏弱",
      "script.literal.009": "CONTENT · HIGH",
      "script.literal.010": "核心阵地",
      "script.literal.011": "稳定触达核心人群，",
      "script.literal.012": "内容持续沉淀品牌资产",
      "script.literal.013": "VALUE · GROW",
      "script.literal.014": "低效占位",
      "script.literal.015": "更新频率与互动都低，",
      "script.literal.016": "投入难以形成有效回报",
      "script.literal.017": "PAUSE · REVIEW",
      "script.literal.018": "流量入口",
      "script.literal.019": "渠道触达稳定且高效，",
      "script.literal.020": "需要更强内容承接转化",
      "script.literal.021": "REACH · CONVERT"
    }
  },
