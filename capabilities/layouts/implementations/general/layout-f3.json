    "values": {
      "html.text.001": "运营 · 述职 — F3",
      "html.text.002": "负责人三大能力盘点",
      "html.text.003": "01 / 01 — BY WISE PPT",
      "html.text.004": "内容策划、用户增长与组织管理三类能力，共同决定运营负责人能否稳定交付结果。",
      "script.literal.001": "内容策划",
      "script.literal.002": "CONTENT PLANNING",
      "script.literal.003": "年度内容日历",
      "script.literal.004": "围绕业务节点安排季度主题与发布节奏",
      "script.literal.005": "YEAR PLAN",
      "script.literal.006": "核心战役策划",
      "script.literal.007": "从目标、人群到创意主张形成完整方案",
      "script.literal.008": "CAMPAIGN",
      "script.literal.009": "内容矩阵设计",
      "script.literal.010": "长短内容按渠道角色分工并持续复用",
      "script.literal.011": "MATRIX",
      "script.literal.012": "渠道节奏管理",
      "script.literal.013": "依据反馈调整频率，保持稳定触达",
      "script.literal.014": "CADENCE",
      "script.literal.015": "用户增长",
      "script.literal.016": "USER GROWTH",
      "script.literal.017": "新增来源拆解",
      "script.literal.018": "按自然、活动与推荐识别有效增长来源",
      "script.literal.019": "SOURCE",
      "script.literal.020": "首日引导优化",
      "script.literal.021": "关键动作前置，让新用户更快获得价值",
      "script.literal.022": "ONBOARD",
      "script.literal.023": "会员权益经营",
      "script.literal.024": "按生命周期匹配内容、权益与触达时机",
      "script.literal.025": "MEMBER",
      "script.literal.026": "沉睡用户唤醒",
      "script.literal.027": "以分层人群和场景化内容降低打扰",
      "script.literal.028": "REACTIVATE",
      "script.literal.029": "组织管理",
      "script.literal.030": "TEAM LEADERSHIP",
      "script.literal.031": "目标拆解",
      "script.literal.032": "把年度目标拆成团队可执行的季度结果",
      "script.literal.033": "OKR 92%",
      "script.literal.034": "跨组协作",
      "script.literal.035": "明确责任边界，让产品、品牌与销售同频",
      "script.literal.036": "ONE TEAM",
      "script.literal.037": "风险预警",
      "script.literal.038": "在延期与口径偏差扩大前及时升级处理",
      "script.literal.039": "复盘机制",
      "script.literal.040": "月度复盘沉淀经验，形成下一轮行动",
      "script.literal.041": "REVIEW"
