    "values": {
      "html.text.001": "品牌 · 述职 — K2",
      "html.text.002": "用户增长负责人年度复盘",
      "html.text.003": "01 / 01 — BY WISE PPT",
      "html.text.004": "本年度以渠道重组、激活改版和会员升级完成增长目标，次留提升 62%，付费用户增至 2.1 倍。",
      "script.literal.001": "PAIN POINTS",
      "script.literal.002": "现状痛点",
      "script.literal.003": "THE FIX",
      "script.literal.004": "运营动作",
      "script.literal.005": "OUTCOME",
      "script.literal.006": "年度成果",
      "script.literal.007": "获客承压",
      "script.literal.008": "渠道成本同比上升，",
      "script.literal.009": "自然新增连续 3 月下滑。",
      "script.literal.010": "CPA↑",
      "script.literal.011": "激活不足",
      "script.literal.012": "新用户激活仅 35%，",
      "script.literal.013": "首周关键行为偏低。",
      "script.literal.014": "RETENTION↓",
      "script.literal.015": "会员转弱",
      "script.literal.016": "付费率仅 3.2%，",
      "script.literal.017": "续费动机与权益感知不足。",
      "script.literal.018": "ARPU↓",
      "script.literal.019": "渠道重组",
      "script.literal.020": "内容与合作渠道并行，",
      "script.literal.021": "自然新增占比提升 60%。",
      "script.literal.022": "REFERRAL",
      "script.literal.023": "激活改版",
      "script.literal.024": "首周 3 步任务 + 提醒，",
      "script.literal.025": "关键动作完成率升至 78%。",
      "script.literal.026": "ONBOARDING",
      "script.literal.027": "会员升级",
      "script.literal.028": "重做月卡 + 年卡权益，",
      "script.literal.029": "付费率 3 月内翻倍。",
      "script.literal.030": "MEMBERSHIP",
      "script.literal.031": "KPI · 0",
      "script.literal.032": "+62%",
      "script.literal.033": "次日留存率",
