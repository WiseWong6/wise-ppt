    "values": {
      "html.text.001": "产品 · 方案 — K3",
      "html.text.002": "内容协同平台方案",
      "html.text.003": "01 / 01 — BY WISE PPT",
      "html.text.004": "内容规范、协作流程与版本追踪统一后，交付周期下降 82%，复用率提升至 4 倍。",
      "script.literal.001": "WHY IT HURTS",
      "script.literal.002": "协作失速的三个根因",
      "script.literal.003": "素材散落",
      "script.literal.004": "文档、图片、脚本分散存放，",
      "script.literal.005": "团队检索路径超过 40 条。",
      "script.literal.006": "口径不一",
      "script.literal.007": "品牌、产品、渠道三方内容口径",
      "script.literal.008": "不一致，版本差异难定位。",
      "script.literal.009": "追溯困难",
      "script.literal.010": "修改意见散落群聊与文档，",
      "script.literal.011": "平均确认时长 2.6 天。",
      "script.literal.012": "THE FIX · CONTENT WORKFLOW",
      "script.literal.013": "内容协同平台",
      "script.literal.014": "需求接入",
      "script.literal.015": "规范对齐",
      "script.literal.016": "素材匹配",
