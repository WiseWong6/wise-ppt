      "html.text.001": "运营 · 活动 — B2",
      "html.text.002": "现场流程与延误点",
      "html.text.003": "01 / 01 — BY WISE PPT",
      "html.text.004": "把签到、联排、嘉宾确认与正式环节放在同一时间轴，延误出现时及时调整顺序。",
      "script.literal.001": "MIN",
      "script.literal.002": "CHECK-IN",
      "script.literal.003": "入场签到",
      "script.literal.004": "SPAN 01",
      "script.literal.005": "02 → 11 · 9M",
      "script.literal.006": "REHEARSAL",
      "script.literal.007": "开场联排",
      "script.literal.008": "SPAN 02",
      "script.literal.009": "08 → 24 · 16M",
      "script.literal.010": "GUEST READY",
      "script.literal.011": "嘉宾确认",
      "script.literal.012": "SPAN 03",
      "script.literal.013": "20 → 58",
      "script.literal.014": "LIVE SESSION",
      "script.literal.015": "正式环节",
      "script.literal.016": "SPAN 04",
      "script.literal.017": "52 → 84 · 32M",
      "script.literal.018": "DELAY FOUND · RUN SHEET UPDATED",
      "script.literal.019": "嘉宾确认延迟，现场顺序即时调整"
    }
  },
