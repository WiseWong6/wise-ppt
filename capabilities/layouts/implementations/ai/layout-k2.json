    "values": {
      "html.text.001": "AI ENGINEERING — K2",
      "html.text.002": "AI READING SYSTEM",
      "html.text.003": "01 / 01 — BY WISE PPT",
      "html.text.004": "自动归档、知识卡片与个人智能体让 600 篇收藏重新可用，每篇速读耗时降至 1 分钟。",
      "script.literal.001": "PAIN POINTS",
      "script.literal.002": "阅读痛点",
      "script.literal.003": "THE FIX",
      "script.literal.004": "AI 解法",
      "script.literal.005": "OUTCOME",
      "script.literal.006": "真实成效",
      "script.literal.007": "收藏夹是坟场",
      "script.literal.008": "文章无限期积压，",
      "script.literal.009": "存了等于没看，越积越多。",
      "script.literal.010": "BACKLOG↑",
      "script.literal.011": "读完就忘",
      "script.literal.012": "没有提炼与归档，",
      "script.literal.013": "一周后内容全忘光。",
      "script.literal.014": "RETENTION↓",
      "script.literal.015": "不会用",
      "script.literal.016": "不知道能问什么，",
      "script.literal.017": "拿到 AI 也只会查天气。",
      "script.literal.018": "USAGE↓",
      "script.literal.019": "AI 阅读系统",
      "script.literal.020": "输入链接自动出卡片，",
      "script.literal.021": "收藏即整理，零负担归档。",
      "script.literal.022": "AUTO READ",
      "script.literal.023": "知识卡片",
      "script.literal.024": "结构化提炼要点，",
      "script.literal.025": "一篇长文压缩成 5 张卡。",
      "script.literal.026": "KNOWLEDGE CARD",
      "script.literal.027": "个人智能体",
      "script.literal.028": "基于知识库问答，",
      "script.literal.029": "随时反查、随时调用。",
      "script.literal.030": "PERSONAL AGENT",
      "script.literal.031": "KPI · 0",
      "script.literal.032": "600",
      "script.literal.033": "份文章已整理",
      "script.literal.034": "1分钟",
      "script.literal.035": "每篇速读耗时"
    }
  },
