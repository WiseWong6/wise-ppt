    "values": {
      "html.text.001": "AI ENGINEERING — F1",
      "html.text.002": "AGENT AUTONOMY × COLLAB",
      "html.text.003": "01 / 01 — BY WISE PPT",
      "html.text.004": "自主性与协同度必须分开评估：蜂群自治两者皆高，独行侠只高自主。",
      "script.literal.001": "高协同",
      "script.literal.002": "COLLAB ↑",
      "script.literal.003": "高自主 →",
      "script.literal.004": "AUTONOMY",
      "script.literal.005": "0",
      "script.literal.006": "集中编排",
      "script.literal.007": "集中编排、统一编队，",
      "script.literal.008": "Agent 靠中心指挥协同",
      "script.literal.009": "CENTRAL · SYNC",
      "script.literal.010": "蜂群自治",
      "script.literal.011": "去中心协商、彼此协调，",
      "script.literal.012": "无需中心也能维持共识",
      "script.literal.013": "DECENTRAL · PEER",
      "script.literal.014": "单 Agent 定线",
      "script.literal.015": "各自走固定流程，",
      "script.literal.016": "互不通信、互不相让",
      "script.literal.017": "ISOLATED · LOOP",
      "script.literal.018": "独行侠",
      "script.literal.019": "自主规划但不协同，",
      "script.literal.020": "能决策却常抢资源",
      "script.literal.021": "FREE · UNSYNC"
    }
  },
