    "values": {
      "html.text.001": "AI 平台 — 协同网络",
      "html.text.002": "能力中枢",
      "html.text.003": "01 / 01 — BY WISE PPT",
      "html.text.004": "统一 AI 平台连接模型、数据、工具与评测，使跨场景能力能够复用。",
      "script.literal.001": "AI 平台中枢",
      "script.literal.002": "MAAS CORE",
      "script.literal.003": "SERV",
      "script.literal.004": "DATA",
      "script.literal.005": "EVAL",
      "script.literal.006": "GATE",
      "script.literal.007": "METER",
      "script.literal.008": "GOVN",
      "script.literal.009": "MOD 01 · SERV",
      "script.literal.010": "模型服务",
      "script.literal.011": "多模型统一接入与路由",
      "script.literal.012": "首字延迟 0.4 秒级",
      "script.literal.013": "MOD 02 · DATA",
      "script.literal.014": "数据管线",
      "script.literal.015": "语料采集清洗到训练就绪",
      "script.literal.016": "管线日处理亿级",
      "script.literal.017": "MOD 03 · EVAL",
      "script.literal.018": "评测体系",
      "script.literal.019": "离线基准与线上 A/B 双轨",
      "script.literal.020": "评测集覆盖率 99%",
      "script.literal.021": "MOD 04 · GATE",
      "script.literal.022": "部署网关",
      "script.literal.023": "灰度发布与流量调度",
      "script.literal.024": "切流 200ms 内",
      "script.literal.025": "MOD 05 · METER",
      "script.literal.026": "监控告警",
      "script.literal.027": "延迟·成本·质量三维监控",
      "script.literal.028": "告警响应 3 秒内",
      "script.literal.029": "MOD 06 · GOVN",
      "script.literal.030": "治理合规",
      "script.literal.031": "内容安全与隐私脱敏审计",
      "script.literal.032": "审计定位到调用级"
    }
  },
