    "values": {
      "html.text.001": "AI ENGINEERING — K3",
      "html.text.002": "AGENT PLATFORM",
      "html.text.003": "01 / 01 — BY WISE PPT",
      "html.text.004": "Agent 基座把幻觉、知识滞后与工具断裂纳入同一链路，召回命中率达到 91%。",
      "script.literal.001": "WHY IT HURTS",
      "script.literal.002": "效果不稳的三个根因",
      "script.literal.003": "幻觉频发",
      "script.literal.004": "长尾问题缺乏知识库接地，",
      "script.literal.005": "生成答案幻觉率一度超 12%。",
      "script.literal.006": "知识滞后",
      "script.literal.007": "产品以周迭代、文档以月更新，",
      "script.literal.008": "检索命中过期文档频发。",
      "script.literal.009": "工具断裂",
      "script.literal.010": "检索、工具、生成链路黑盒，",
      "script.literal.011": "坏例定位平均耗时 2.6 天。",
      "script.literal.012": "THE FIX · AGENT PIPELINE",
      "script.literal.013": "Agent 基座平台",
      "script.literal.014": "意图解析",
      "script.literal.015": "知识召回",
      "script.literal.016": "工具编排",
      "script.literal.017": "生成校验",
      "script.literal.018": "灰度放量",
      "script.literal.019": "追踪回放",
      "script.literal.020": "PARSE",
      "script.literal.021": "RETRIEVE",
      "script.literal.022": "ORCHESTRATE",
      "script.literal.023": "VERIFY",
      "script.literal.024": "CANARY",
      "script.literal.025": "REPLAY",
      "script.literal.026": "AGENT INFRA 1.0 · BASE",
      "script.literal.027": "模型网关",
      "script.literal.028": "向量检索",
      "script.literal.029": "提示词版本",
      "script.literal.030": "评测台",
      "script.literal.031": "可观测",
      "script.literal.032": "-58%",
