      "script.literal.016": "ENGINEERING",
      "script.literal.017": "Harness 设计",
      "script.literal.018": "提示词、上下文与流程编排一体化",
      "script.literal.019": "PROMPT",
      "script.literal.020": "上下文管控",
      "script.literal.021": "长会话压缩、记忆与窗口策略",
      "script.literal.022": "CONTEXT",
      "script.literal.023": "评测体系",
      "script.literal.024": "建立离线与线上双轨评测基准",
      "script.literal.025": "EVAL",
      "script.literal.026": "语料与反馈",
      "script.literal.027": "语料管线、标注治理与反馈闭环",
      "script.literal.028": "DATA",
