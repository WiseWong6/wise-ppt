{
  "contract_version": 1,
  "format": "wise-ppt-scaffold-registry@1",
  "description": "骨架版式注册表：整页页面类型（封面/目录/章节隔页/尾卡）。骨架版式不进拓扑注册表（它们不是内容槽的空间关系），不进组件目录（没有可替换的内容槽组件）；页面结构由 page shell 按 page_kind 直接渲染，输入只来自 Deck Plan 的 deck 级与 page 级元数据。联络尾页（D6）保持普通内容页：左右分栏拓扑 + 联络卡/地图组件。",
  "canvas": { "width": 1920, "height": 1080 },
  "scaffold_count": 5,
  "scaffolds": [
    {
      "scaffold_id": "scaffold.cover",
      "name": "封面",
      "page_kind": "cover",
      "conclusion_mode": "none",
      "folio": true,
      "inputs": ["deck.title", "deck.subtitle", "deck.kicker", "deck.meta"],
      "design_evidence": {
        "general": "gallery/paper-ink/general/frames/layout-d1.html",
        "ai": "gallery/paper-ink/ai/frames/layout-d1.html"
      }
    },
    {
      "scaffold_id": "scaffold.agenda",
      "name": "目录导航页",
      "page_kind": "agenda",
      "conclusion_mode": "none",
      "folio": true,
      "inputs": ["deck.sections[] (section_id, title, 页码范围)"],
      "design_evidence": {
        "general": "gallery/paper-ink/general/frames/layout-d4.html",
        "ai": "gallery/paper-ink/ai/frames/layout-d4.html"
      }
    },
    {
      "scaffold_id": "scaffold.section-divider",
      "name": "章节隔页",
      "page_kind": "section-divider",
      "conclusion_mode": "none",
      "folio": true,
      "inputs": ["page.section_id", "section.title", "section.index"],
      "design_evidence": {
        "general": "gallery/paper-ink/general/frames/layout-d5.html",
        "ai": "gallery/paper-ink/ai/frames/layout-d5.html"
      }
    },
    {
      "scaffold_id": "scaffold.outro-minimal",
      "name": "极简尾卡",
      "page_kind": "outro",
      "variant": "minimal",
      "conclusion_mode": "none",
      "folio": true,
      "inputs": ["deck.title", "deck.meta"],
      "design_evidence": {
        "general": "gallery/paper-ink/general/frames/layout-d3.html",
        "ai": "gallery/paper-ink/ai/frames/layout-d3.html"
      }
    },
    {
      "scaffold_id": "scaffold.outro-particle",
      "name": "粒子大字尾卡",
      "page_kind": "outro",
      "variant": "particle",
      "conclusion_mode": "none",
      "folio": true,
      "inputs": ["deck.title"],
      "design_evidence": {
        "general": "gallery/paper-ink/general/frames/layout-d2.html",
        "ai": "gallery/paper-ink/ai/frames/layout-d2.html"
      }
    }
  ]
}
